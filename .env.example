# API (services/api). Defaults work for local development without Docker.
DATABASE_URL=sqlite:///./var/echospace.db
OBJECT_STORE=local
OBJECT_STORE_DIR=./var/objects
CORS_ORIGINS=http://localhost:3000
RAW_RETENTION_DAYS=7
LOG_LEVEL=info
# Set to export traces, e.g. http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Web app
NEXT_PUBLIC_API_URL=http://localhost:8000
