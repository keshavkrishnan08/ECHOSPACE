{
  "name": "echospace",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "description": "ECHO: finding people with Wi-Fi signals. Simulation, signal processing, 3D reconstruction and tracking in the browser.",
  "packageManager": "pnpm@10.12.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @echospace/web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm -r lint",
    "test": "pnpm -r test",
    "e2e": "pnpm --filter @echospace/web e2e"
  }
}
